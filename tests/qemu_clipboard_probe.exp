#!/usr/bin/expect -f
# Cross-world clipboard probe (facility audit F1 payoff): proves the
# clipboard is ONE store bridging console and GUI on real hardware.
#
# Flow: boot -> console getty 'login:' -> root/skyos -> sash -> type
# 'echo CLIPX_PAYLOAD', Esc, Y (Command-mode yank: whole line ->
# libsarga::io::clipboard_write -> SYS_CLIPBOARD=125) -> i, Enter (runs
# echo, marker prints on serial as the console-side reference) -> ensure
# ade is running (healthy GUI: already exec'd by login-manager; broken
# GUI: launch 'ade' from the console shell, the probe_console_login
# path) -> sendkey ctrl-b (ade's ClipboardPanel key) -> ade reads the
# KERNEL store (libsarga clipboard_len + clipboard_read) and prints
# '[clip] kernel store: echo CLIPX_PAYLOAD' -> the yanked bytes arrive
# on the GUI side, closing the loop.
#
# PER-CHECK AUDIT - every pattern verified against sources:
#   1 boot_login       login:            REAL  login/src/main.rs:212
#   2 vahid_ready      \\[vahid\\] ready   REAL  vahid/src/main.rs:108 (healthy
#                                            sleep loop; accumulated-buffer
#                                            grep after 'login:', same as
#                                            probe_console_login.exp)
#   3 password_prompt  Password:         REAL  login/src/main.rs:132
#   4 shell_prompt     sash\\[            REAL  root's shell /bin/sash; PS1
#                                            "sash[\\w]> "
#   5 yank_submit      echo CLIPX_PAYLOAD
#                                            REAL  sash/src/readline.rs 'Y'
#                                            arm (yank whole line ->
#                                            clipboard_write) then 'i' +
#                                            Enter runs the line; the echo
#                                            output is the console-side
#                                            reference for the marker
#   6 ade_established  \\[ade\\] session established
#                                            REAL  ade/src/main.rs:73 (healthy
#                                            GUI: already in the accumulated
#                                            buffer; broken GUI: launched
#                                            from the console shell)
#   7 clip_store       \\[clip\\] kernel store: echo CLIPX_PAYLOAD
#                                            REAL  ade/src/core/desktop.rs
#                                            ClipboardPanel arm (Ctrl+B):
#                                            prints clipboard_len +
#                                            clipboard_read of the kernel
#                                            store. THE cross-world assert.
#   8 clip_empty       \\[clip\\] kernel store: \\(empty\\)
#                                            REAL  same arm when the store is
#                                            empty -> the console yank never
#                                            reached SYS_CLIPBOARD (diagnostic
#                                            FAIL, distinct from routing)
#
# Usage: expect tests/qemu_clipboard_probe.exp <iso_path> [timeout_seconds]

set iso [lindex $argv 0]
set timeout [lindex $argv 1]
if {$timeout == ""} { set timeout 240 }
set logfile "qemu_clipboard_probe_log.txt"

spawn qemu-system-x86_64 \
    -bios OVMF.fd \
    -cdrom "$iso" \
    -m 512M -smp 2 \
    -nographic -no-reboot \
    -serial mon:stdio \
    -device e1000,netdev=net0 -netdev user,id=net0

# Keep the whole boot in the expect buffer (default match_max is 2000
# bytes): the '[vahid] ready' and (healthy-GUI) '[ade] session
# established' markers print early and this probe greps the ACCUMULATED
# buffer, so without the bump they would have rolled out. Set AFTER
# spawn - match_max targets the current spawn_id.
match_max 1000000

# Ctrl-A C toggles the serial console <-> QEMU monitor on mon:stdio. The
# login + yank half types on the serial console; only the GUI ctrl-b
# needs the monitor (ade reads SYS_GUI_GET_KEY, not the console).
proc monitor_cmd {cmd} {
    send "\x01c"
    expect -timeout 5 {
        "(qemu) " {}
        timeout { send_user "FAIL: QEMU monitor not reachable\n"; exit 1 }
    }
    send "$cmd\r"
    expect -timeout 5 {
        "(qemu) " {}
        timeout { send_user "FAIL: monitor command '$cmd' not acknowledged\n"; exit 1 }
    }
    send "\x01c"
}

proc sendkey_seq {keys} {
    monitor_cmd "sendkey $keys"
}

proc send_password {pw} {
    log_user 0
    send "$pw\r"
    log_user 1
}

set pass_count 0
set fail_count 0

# 1. Boot: the console getty's login: prompt.
send_user "=== 1. boot to console getty ===\n"
expect -timeout 90 {
    -re {login: } {
        incr pass_count
        send_user "PASS: console getty login prompt\n"
    }
    "=== KERNEL PANIC ===" {
        incr fail_count
        send_user "FAIL: kernel panicked during boot\n"
        exit 1
    }
    timeout {
        incr fail_count
        send_user "FAIL: boot timeout - no 'login:' (console path)\n"
        exit 1
    }
    eof {
        incr fail_count
        send_user "FAIL: QEMU exited during boot\n"
        exit 1
    }
}

# 2. vahid-healthy: the device manager reached its sleep loop.
if {[regexp -- {\[vahid\] ready} $expect_out(buffer)]} {
    incr pass_count
    send_user "PASS: vahid_ready - device manager healthy in accumulated boot log\n"
} else {
    incr fail_count
    send_user "FAIL: vahid_ready - '\[vahid] ready' missing from accumulated boot log\n"
    exit 1
}

# 3. Console login root/skyos over the serial console.
send_user "=== 2. console login root/skyos ===\n"
send "root\r"
expect -timeout 20 {
    -re {Password: } {
        incr pass_count
        send_user "PASS: password prompt\n"
    }
    timeout { send_user "FAIL: no Password: prompt\n"; exit 1 }
    eof { send_user "FAIL: QEMU exited at password prompt\n"; exit 1 }
}
send_password "skyos"

expect -timeout 20 {
    -re {sash\[} {
        incr pass_count
        send_user "PASS: console login landed at sash\n"
    }
    -re {Login incorrect} {
        send_user "FAIL: bad credentials - console login rejected\n"
        exit 1
    }
    timeout {
        send_user "FAIL: no sash prompt after skyos (wrong password or hang)\n"
        exit 1
    }
    eof { send_user "FAIL: QEMU exited during login\n"; exit 1 }
}

# 4. Console-side yank: type 'echo CLIPX_PAYLOAD', Esc (Insert ->
#    Command), Y (Command-mode yank: whole line -> clipboard_write ->
#    kernel SYS_CLIPBOARD), i (back to Insert), Enter (runs the line; the
#    echo output prints the marker as the console-side reference).
send_user "=== 3. console yank to kernel clipboard ===\n"
send "echo CLIPX_PAYLOAD"
send "\x1b"
send "Y"
send "i"
send "\r"
# The submitted 'echo CLIPX_PAYLOAD' runs and prints the marker; wait for
# the sash prompt to return (command completed).
expect -timeout 15 {
    -re {sash\[} {
        incr pass_count
        send_user "PASS: yank submitted - 'echo CLIPX_PAYLOAD' ran, prompt returned\n"
    }
    timeout {
        incr fail_count
        send_user "FAIL: sash did not return to the prompt after the yank (line not submitted?)\n"
        exit 1
    }
    eof { send_user "FAIL: QEMU exited during the yank\n"; exit 1 }
}

# 5. Ensure ade is running to receive ctrl-b. Healthy GUI: login-manager
#    already exec'd ade ('[ade] session established' in the accumulated
#    buffer). Broken GUI: launch from the console shell (the
#    probe_console_login path) - a console-launched ade still reads GUI
#    keys, proven by that probe's sendkey Esc logout.
if {![regexp -- {\[ade\] session established} $expect_out(buffer)]} {
    send_user "=== 4. ade not yet running - launching from console shell ===\n"
    send "ade\r"
    expect -timeout 30 {
        -re {\[ade\] session established} {
            incr pass_count
            send_user "PASS: ade session established via console path\n"
        }
        -re {not found|ade:} {
            send_user "FAIL: sash could not exec ade (check PATH / initrd)\n"
            exit 1
        }
        -re {\[ade\] failed to create window} {
            incr fail_count
            send_user "FAIL: ade could not create a window (GUI hang)\n"
            exit 1
        }
        timeout {
            incr fail_count
            send_user "FAIL: no '\[ade] session established' after launching ade\n"
            exit 1
        }
        eof { send_user "FAIL: QEMU exited during ade launch\n"; exit 1 }
    }
} else {
    send_user "=== 4. ade already running (healthy GUI) ===\n"
    incr pass_count
    send_user "PASS: ade session established in accumulated boot log\n"
}

# 6. The cross-world assert: ctrl-b opens ade's clipboard panel, whose
#    arm reads the KERNEL store and prints it to serial. If the yanked
#    bytes arrive, the loop is closed: sash (console) -> SYS_CLIPBOARD ->
#    ade (GUI) read. No stale-marker absent-check is needed: '[clip]'
#    lines are only produced by a ctrl-b, and this is the first.
send_user "=== 5. GUI paste probe: sendkey ctrl-b ===\n"
sendkey_seq "ctrl-b"
expect -timeout 20 {
    -re {\[clip\] kernel store: echo CLIPX_PAYLOAD} {
        incr pass_count
        send_user "PASS: cross-world clipboard loop - console yank reached the GUI kernel-store read\n"
    }
    -re {\[clip\] kernel store: \(empty read\)} {
        incr fail_count
        send_user "FAIL: GUI read the kernel store but got zero bytes (read raced a clear?)\n"
        exit 1
    }
    -re {\[clip\] kernel store: \(empty\)} {
        incr fail_count
        send_user "FAIL: kernel store empty at GUI read - the console yank never reached SYS_CLIPBOARD\n"
        exit 1
    }
    timeout {
        incr fail_count
        send_user "FAIL: no '\[clip] kernel store:' line - ctrl-b never reached ade (GUI key routing) or ade not running\n"
        exit 1
    }
    eof { send_user "FAIL: QEMU exited during the GUI paste probe\n"; exit 1 }
}

send_user "\nCross-world clipboard probe: $pass_count passed, $fail_count failed\n"
if {$fail_count > 0} { exit 1 }
exit 0
