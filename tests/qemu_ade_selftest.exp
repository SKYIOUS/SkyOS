#!/usr/bin/expect -f
# ADE selftest integration: boots the SkyOS ISO, logs in on the serial
# console, runs `ade --selftest`, and requires the "[ade] selftest PASS"
# verdict. Exits 1 on login failure, a FAIL verdict, a panic, timeout, or
# early exit. After the verdict it launches `ade` interactively and
# proves the byte-path session-end contract on REAL input: a QEMU-monitor
# Esc (`sendkey esc`) on the empty desktop must unwind the session with
# "[ade] session ended code=0 ending=true" (the a11y Esc arm \u2014 0x1B is the one
# distinct control byte the key stream carries \u2014 pinned synthetically by
# test_session_end_gate / test_logout_protocol_from_chord). Before the
# real login it drives the ATTEMPT CAP:
# sends 10 wrong passwords to trigger MAX_FAILED_ATTEMPTS, asserts the
# "Too many failed attempts - pausing 30s" marker appears exactly once,
# waits for the 30s backoff, then confirms a fresh "login:" re-prompt
# (proving the getty survives the cap, not just a single mistype).
# Then a final wrong password (11th) proves the counter was reset.
# Only then does it log in correctly, proving the getty never exited
# at any point — the MAX_RESPAWNS guard holds through the full cap.
#
# This closes the P9 gap from ade/docs/rebuild-plan.md: the selftest suite
# used to run only under `--selftest` locally; CI now boots the real ISO and
# drives it. `ade --selftest` prints "[ade] selftest PASS|FAIL" and exits
# 0/1 before creating any GUI window (see ade/src/main.rs).
#
# Usage: expect qemu_ade_selftest.exp <iso_path> [timeout_seconds]

set iso [lindex $argv 0]
set timeout [lindex $argv 1]
if {$timeout == ""} { set timeout 240 }

spawn qemu-system-x86_64 \
    -bios OVMF.fd \
    -cdrom "$iso" \
    -m 512M -smp 2 \
    -nographic -no-reboot \
    -serial mon:stdio \
    -device e1000,netdev=net0 -netdev user,id=net0

# 1. Boot to the console login prompt (/bin/login on the serial console).
expect {
    "login:" { send_user "PASS: boot reached login prompt\n" }
    "SARGA OS PANIC" { send_user "FAIL: kernel panicked during boot\n"; exit 1 }
    timeout { send_user "FAIL: no login prompt (boot timeout)\n"; exit 1 }
    eof { send_user "FAIL: QEMU exited before login\n"; exit 1 }
}

# 1b. Attempt-cap probe: drive the getty's MAX_FAILED_ATTEMPTS=10
#     backoff to prove the cap itself keeps the getty alive, not just
#     a single mistype. Sends 10 wrong passwords to trigger "Too many
#     failed attempts - pausing 30s", confirms it fires exactly once,
#     waits for the 30s backoff, then sends an 11th wrong password to
#     prove the counter was reset (login accepts input again). Only
#     then does it log in correctly, proving the getty NEVER exited
#     through the full cycle — the MAX_RESPAWNS guard holds.
proc send_bad_password {} {
    send "root\r"
    expect {
        "Password:" { }
        "SARGA OS PANIC" { send_user "FAIL: kernel panicked during cap\n"; exit 1 }
        timeout { send_user "FAIL: no password prompt during cap\n"; exit 1 }
        eof { send_user "FAIL: QEMU exited during cap\n"; exit 1 }
    }
    log_user 0
    send "not-the-password\r"
    log_user 1
    expect {
        "Login incorrect" { }
        "SARGA OS PANIC" { send_user "FAIL: kernel panicked during cap\n"; exit 1 }
        timeout { send_user "FAIL: wrong password not rejected during cap\n"; exit 1 }
        eof { send_user "FAIL: QEMU exited during cap\n"; exit 1 }
    }
}

send_user "=== Attempt-cap probe: 10 wrong passwords ===\n"
for {set i 1} {$i < 10} {incr i} {
    send_bad_password
    expect {
        "login: " { send_user "PASS: attempt $i rejected, re-prompted\n" }
        {\[init\] starting service: getty} {
            send_user "FAIL: getty respawned at attempt $i\n"
            exit 1
        }
        "SARGA OS PANIC" { send_user "FAIL: kernel panicked at attempt $i\n"; exit 1 }
        timeout { send_user "FAIL: no re-prompt after attempt $i\n"; exit 1 }
        eof { send_user "FAIL: QEMU exited at attempt $i\n"; exit 1 }
    }
}
# 10th attempt: triggers the cap (MAX_FAILED_ATTEMPTS reached).
send_user "PASS: 9 attempts handled, triggering cap on 10th\n"
send_bad_password
expect {
    "Too many failed attempts - pausing 30s" {
        send_user "PASS: attempt cap activated on 10th failure\n"
    }
    "Login incorrect" {
        # Possible race: pause message arrives AFTER "Login incorrect"
        # in the same buffer; expect consumes the line and leaves the
        # pause marker for the next expect.
        send_user "INFO: Login incorrect consumed first, waiting for cap marker\n"
        expect {
            "Too many failed attempts - pausing 30s" {
                send_user "PASS: attempt cap activated on 10th failure\n"
            }
            timeout { send_user "FAIL: cap marker not found after Login incorrect\n"; exit 1 }
        }
    }
    {\[init\] starting service: getty} {
        send_user "FAIL: getty respawned at cap (10th attempt)\n"
        exit 1
    }
    "SARGA OS PANIC" { send_user "FAIL: kernel panicked at cap\n"; exit 1 }
    timeout { send_user "FAIL: cap marker never appeared\n"; exit 1 }
    eof { send_user "FAIL: QEMU exited at cap\n"; exit 1 }
}
# After the 30s backoff, the getty resets its counter and re-prompts.
expect -timeout 60 {
    "login: " { send_user "PASS: getty re-prompted after 30s backoff\n" }
    {\[init\] starting service: getty} {
        send_user "FAIL: getty respawned during backoff\n"
        exit 1
    }
    "SARGA OS PANIC" { send_user "FAIL: kernel panicked during backoff\n"; exit 1 }
    timeout { send_user "FAIL: no login prompt after 30s backoff\n"; exit 1 }
    eof { send_user "FAIL: QEMU exited during backoff\n"; exit 1 }
}

# 11th attempt: post-cap confirm (counter was reset, normal re-prompt).
send_user "=== Post-cap confirm: 11th wrong password ===\n"
send_bad_password
expect {
    "login: " { send_user "PASS: post-cap attempt rejected, re-prompted (counter reset)\n" }
    {\[init\] starting service: getty} {
        send_user "FAIL: getty respawned post-cap\n"
        exit 1
    }
    "SARGA OS PANIC" { send_user "FAIL: kernel panicked post-cap\n"; exit 1 }
    timeout { send_user "FAIL: no re-prompt post-cap\n"; exit 1 }
    eof { send_user "FAIL: QEMU exited post-cap\n"; exit 1 }
}

# --- correct login ---
send_user "=== Logging in correctly ===\n"
send "root\r"
expect {
    "Password:" { send_user "PASS: password prompt\n" }
    "Login incorrect" { send_user "FAIL: real login rejected after cap probe\n"; exit 1 }
    "SARGA OS PANIC" { send_user "FAIL: kernel panicked at login\n"; exit 1 }
    timeout { send_user "FAIL: no password prompt\n"; exit 1 }
    eof { send_user "FAIL: QEMU exited at login\n"; exit 1 }
}
log_user 0
send "skyos\r"
log_user 1

# 3. Wait for the shell prompt, then run the ade selftest suite.
expect {
    {sash\[} { send_user "PASS: logged in, shell ready\n" }
    "Login incorrect" { send_user "FAIL: login rejected (check initrd shadow)\n"; exit 1 }
    "SARGA OS PANIC" { send_user "FAIL: kernel panicked at shell\n"; exit 1 }
    timeout { send_user "FAIL: shell prompt never appeared\n"; exit 1 }
    eof { send_user "FAIL: QEMU exited at shell\n"; exit 1 }
}

send_user "=== Running ade --selftest ===\n"
send "ade --selftest\r"

# 4a1. The a11y Close-activation coverage must have RUN and PASSED: the aggregate verdict in 4b would also fail on a failing a11y test, but this positively asserts the coverage executed: a panic before the a11y tests, or a future unwiring of the a11y tests from run_all, would otherwise only surface as a missing verdict. The brace-quoted glob keeps the square brackets literal.
expect {
    {\[test\] PASS test_a11y_close_button} {
        send_user "PASS: a11y close-button activation coverage passed\n"
    }
    {\[test\] FAIL test_a11y_close_button} {
        send_user "FAIL: a11y close-button activation test failed\n"
        exit 1
    }
    "SARGA OS PANIC" {
        send_user "FAIL: ade panicked before the test_a11y_close_button coverage\n"
        exit 1
    }
    timeout {
        send_user "FAIL: test_a11y_close_button coverage never reported\n"
        exit 1
    }
    eof {
        send_user "FAIL: QEMU exited before the test_a11y_close_button coverage\n"
        exit 1
    }
}
# 4a2. The taskbar-button activation coverage must have RUN and PASSED: activating a taskbar button brings its window to front (or restores it), a regression that breaks the owner stamp or the focus switch would otherwise only surface as a missing verdict.
expect {
    {\[test\] PASS test_a11y_taskbar_button} {
        send_user "PASS: a11y taskbar-button activation coverage passed\n"
    }
    {\[test\] FAIL test_a11y_taskbar_button} {
        send_user "FAIL: a11y taskbar-button activation test failed\n"
        exit 1
    }
    "SARGA OS PANIC" {
        send_user "FAIL: ade panicked before the test_a11y_taskbar_button coverage\n"
        exit 1
    }
    timeout {
        send_user "FAIL: test_a11y_taskbar_button coverage never reported\n"
        exit 1
    }
    eof {
        send_user "FAIL: QEMU exited before the test_a11y_taskbar_button coverage\n"
        exit 1
    }
}
# 4a3. The tooltip owner-label coverage must have RUN and PASSED: Close and Minimize nodes show 'Close <title>' / 'Minimize <title>' from the owning window, so a regression in the owner stamp or label lookup aborts here instead of surfacing as a missing verdict.
expect {
    {\[test\] PASS test_tooltip_owner_label} {
        send_user "PASS: tooltip owner-label coverage passed\n"
    }
    {\[test\] FAIL test_tooltip_owner_label} {
        send_user "FAIL: tooltip owner-label test failed\n"
        exit 1
    }
    "SARGA OS PANIC" {
        send_user "FAIL: ade panicked before the test_tooltip_owner_label coverage\n"
        exit 1
    }
    timeout {
        send_user "FAIL: test_tooltip_owner_label coverage never reported\n"
        exit 1
    }
    eof {
        send_user "FAIL: QEMU exited before the test_tooltip_owner_label coverage\n"
        exit 1
    }
}
# 4a4. The a11y-close focus re-sync coverage must have RUN and PASSED: closing via Enter must move the ring to the sibling window's surface, not leave it on a stale node or blur entirely.
expect {
    {\[test\] PASS test_a11y_close_resyncs_focus} {
        send_user "PASS: a11y close focus re-sync coverage passed\n"
    }
    {\[test\] FAIL test_a11y_close_resyncs_focus} {
        send_user "FAIL: a11y close focus re-sync test failed\n"
        exit 1
    }
    "SARGA OS PANIC" {
        send_user "FAIL: ade panicked before the test_a11y_close_resyncs_focus coverage\n"
        exit 1
    }
    timeout {
        send_user "FAIL: test_a11y_close_resyncs_focus coverage never reported\n"
        exit 1
    }
    eof {
        send_user "FAIL: QEMU exited before the test_a11y_close_resyncs_focus coverage\n"
        exit 1
    }
}
# 4a5. The re-sync sentinel-exclusion coverage must have RUN and PASSED: Pass 1 of preferred_target must skip the closing window's own nodes AND the START_BUTTON_OWNER sentinel, so the ring lands on a real sibling taskbar button, not the Start menu.
expect {
    {\[test\] PASS test_a11y_resync_exclusion} {
        send_user "PASS: a11y re-sync sentinel-exclusion coverage passed\n"
    }
    {\[test\] FAIL test_a11y_resync_exclusion} {
        send_user "FAIL: a11y re-sync sentinel-exclusion test failed\n"
        exit 1
    }
    "SARGA OS PANIC" {
        send_user "FAIL: ade panicked before the test_a11y_resync_exclusion coverage\n"
        exit 1
    }
    timeout {
        send_user "FAIL: test_a11y_resync_exclusion coverage never reported\n"
        exit 1
    }
    eof {
        send_user "FAIL: QEMU exited before the test_a11y_resync_exclusion coverage\n"
        exit 1
    }
}
# 4a6. The central focus-lifecycle coverage must have RUN and PASSED: FocusManager::validate (build_tree's focus-sync step) is the only thing that keeps the ring alive when a window closes on a non-a11y path (mouse, Ctrl+W) - a regression that drops it would only surface as a missing verdict without this positive assertion.
expect {
    {\[test\] PASS test_focus_validate_central} {
        send_user "PASS: central focus-lifecycle coverage passed\n"
    }
    {\[test\] FAIL test_focus_validate_central} {
        send_user "FAIL: central focus-lifecycle test failed\n"
        exit 1
    }
    "SARGA OS PANIC" {
        send_user "FAIL: ade panicked before the test_focus_validate_central coverage\n"
        exit 1
    }
    timeout {
        send_user "FAIL: test_focus_validate_central coverage never reported\n"
        exit 1
    }
    eof {
        send_user "FAIL: QEMU exited before the test_focus_validate_central coverage\n"
        exit 1
    }
}
# 4a6b. The two-step dismissal contract must have RUN and PASSED: the first
# Enter dismisses the overlay, the next Enter acts on the still-focused
# node (Close closes). The per-step `[a11y]` marker proves the second
# Enter ACTED -- the aggregate PASS line for the test cannot. A regression
# that turns the second Enter into a no-op (or drops the step) would
# otherwise only surface as a missing verdict.
expect {
    {\[a11y\] test_a11y_activation_dismisses_overlays second Enter acts: PASS} {
        send_user "PASS: two-step dismissal contract held (dismiss then act)\n"
    }
    {\[test\] FAIL test_a11y_activation_dismisses_overlays} {
        send_user "FAIL: activation overlay-dismissal test failed before the two-step marker\n"
        exit 1
    }
    "SARGA OS PANIC" {
        send_user "FAIL: ade panicked before the two-step dismissal marker\n"
        exit 1
    }
    timeout {
        send_user "FAIL: two-step dismissal marker never reported\n"
        exit 1
    }
    eof {
        send_user "FAIL: QEMU exited before the two-step dismissal marker\n"
        exit 1
    }
}
# 4a7. The activation overlay-dismissal coverage must have RUN and PASSED: activating a node must dismiss open overlays (start menu / context menu / settings / task-manager / about) first, behaving exactly like a mouse click when a modal is up.
expect {
    {\[test\] PASS test_a11y_activation_dismisses_overlays} {
        send_user "PASS: a11y activation overlay-dismissal coverage passed\n"
    }
    {\[test\] FAIL test_a11y_activation_dismisses_overlays} {
        send_user "FAIL: a11y activation overlay-dismissal test failed\n"
