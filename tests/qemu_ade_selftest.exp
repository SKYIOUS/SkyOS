}

# 4a12. The tray-panel coverage must also have RUN and PASSED: the a11y
#     tree models the tray panel (entries + clock) as one owner-stamped
#     TrayPanel node spanning tray_panel_rect, and hovering entry 0 reports
#     the unified tray hover. A regression that drops the node or breaks the
#     panel-derived hover geometry would only surface as a missing verdict
#     without this positive assertion.
expect {
    {\[test\] PASS test_a11y_tray_panel} {
        send_user "PASS: a11y tray-panel coverage passed\n"
    }
    {\[test\] FAIL test_a11y_tray_panel} {
        send_user "FAIL: a11y tray-panel test failed\n"
        exit 1
    }
    "SARGA OS PANIC" {
        send_user "FAIL: ade panicked before the tray-panel coverage\n"
        exit 1
    }
    timeout {
        send_user "FAIL: tray-panel coverage never reported\n"
        exit 1
    }
    eof {
        send_user "FAIL: QEMU exited before the tray-panel coverage\n"
        exit 1
    }
}
# 4a13. The byte-stream arrow navigation coverage must have RUN and
#     PASSED: the a11y ring drives from the E0 second-byte arrow codes
#     72/75/77/80 (kernel-keyboard-gate.md section 2.1 forward set)
#     through the real event path, and modified arrows (shift/ctrl/alt
#     bits) are inert -- the a11y modifier guard swallows them before
#     the arrow arms. A regression that drops the arms (leaving arrows
#     to type 'H'/'K'/'M'/'P') would only surface as a missing verdict
#     without this positive assertion.
expect {
    {\[test\] PASS test_a11y_arrows_from_byte_stream} {
        send_user "PASS: a11y byte-stream arrow navigation coverage passed\n"
    }
    {\[test\] FAIL test_a11y_arrows_from_byte_stream} {
        send_user "FAIL: a11y byte-stream arrow navigation test failed\n"
        exit 1
    }
    "SARGA OS PANIC" {
        send_user "FAIL: ade panicked before the byte-stream arrow navigation coverage\n"
        exit 1
    }
    timeout {
        send_user "FAIL: byte-stream arrow navigation coverage never reported\n"
        exit 1
    }
    eof {
        send_user "FAIL: QEMU exited before the byte-stream arrow navigation coverage\n"
        exit 1
    }
}

# 4a14. The full logout protocol must have RUN and PASSED: the
# chord -> is_ending() -> exit_code()==0 chain pinned by
# test_logout_protocol_from_chord is asserted in CI, not just by the
# aggregate verdict. The test's Esc twin drives the SAME protocol through
# the real byte path (0x1B on the empty desktop), so this grep covers the
# byte-deliverable session-end contract alongside the synthetic chord -
# the marker this harness also proves end-to-end in step 5 (sendkey esc).
expect {
    {\[test\] PASS test_logout_protocol_from_chord} {
        send_user "PASS: logout protocol (chord + Esc byte path) coverage passed\n"
    }
    {\[test\] FAIL test_logout_protocol_from_chord} {
        send_user "FAIL: logout protocol test failed\n"
        exit 1
    }
    "SARGA OS PANIC" {
        send_user "FAIL: ade panicked before the logout protocol coverage\n"
        exit 1
    }
    timeout {
        send_user "FAIL: logout protocol coverage never reported\n"
        exit 1
    }
    eof {
        send_user "FAIL: QEMU exited before the logout protocol coverage\n"
        exit 1
    }
}

# 4b. The verdict is what gates the pipeline. The patterns match the plain
#     "selftest PASS|FAIL" substring — ade prints "[ade] selftest PASS|FAIL".
#     A panic during the suite exits via the panic handler without a verdict,
#     so it is matched explicitly for a fast, diagnosable failure.
expect {
    "selftest PASS" { send_user "PASS: ade selftest suite passed\n" }
    "selftest FAIL" {
        send_user "FAIL: ade selftest suite reported failures\n"
        exit 1
    }
    "SARGA OS PANIC" {
        send_user "FAIL: ade panicked during the selftest suite\n"
        exit 1
    }
    timeout {
        send_user "FAIL: ade --selftest timed out without a verdict\n"
        exit 1
    }
    eof {
        send_user "FAIL: QEMU exited before the selftest verdict\n"
        exit 1
    }
}

# --- 5. Real-hardware Esc session-end probe (byte path) ---
# `ade --selftest` exited after the verdict; the shell is back. Launch ade
# interactively from the console, wait for the desktop, then inject a REAL
# hardware Esc through the QEMU monitor (`sendkey esc` -> i8042 -> IRQ1 ->
# kernel GUI pipeline -> Unicode 0x1B -> get_key -> a11y Esc arm). On the
# empty desktop (no windows open) that is the byte-deliverable session-end
# path: Esc must unwind the session and print the rich marker
# '[ade] session ended code=0 ending=true' - the same contract
# test_session_end_gate / test_logout_protocol_from_chord pin synthetically,
# now proven on real input.
proc monitor_cmd {cmd} {
    send "\x01c"
    expect -timeout 5 {
        "(qemu) " {}
        timeout { send_user "FAIL: QEMU monitor not reachable\n"; exit 1 }
    }
    send "$cmd\r"
    expect -timeout 5 {
        "(qemu) " {}
        timeout { send_user "FAIL: monitor command '$cmd' not acknowledged\n"; exit 1 }
    }
    send "\x01c"
}

expect {
    {sash\[} { send_user "PASS: shell returned after selftest verdict\n" }
    "SARGA OS PANIC" { send_user "FAIL: kernel panicked after selftest verdict\n"; exit 1 }
    timeout { send_user "FAIL: shell did not return after selftest verdict\n"; exit 1 }
    eof { send_user "FAIL: QEMU exited after selftest verdict\n"; exit 1 }
}
send "ade\r"
expect {
    {\[ade\] session established} {
        send_user "PASS: interactive ade desktop established\n"
    }
    {\[ade\] failed to create window} {
        send_user "FAIL: ade could not create its GUI window - the byte-path Esc probe cannot run (GUI gate)\n"
        exit 1
    }
    "SARGA OS PANIC" { send_user "FAIL: kernel panicked starting ade\n"; exit 1 }
    timeout { send_user "FAIL: ade desktop never established\n"; exit 1 }
    eof { send_user "FAIL: QEMU exited starting ade\n"; exit 1 }
}
monitor_cmd "sendkey esc"
expect {
    {\[ade\] session ended code=0 ending=true} {
        send_user "PASS: hardware Esc ended the session on the empty desktop - '\[ade\] session ended code=0 ending=true'\n"
    }
    "SARGA OS PANIC" { send_user "FAIL: kernel panicked on hardware Esc\n"; exit 1 }
    timeout { send_user "FAIL: hardware Esc did not end the session (byte-path contract broken)\n"; exit 1 }
    eof { send_user "FAIL: QEMU exited before the session ended\n"; exit 1 }
}
# The marker is printed at unwind; the process must then exit and the shell
# return - proving the session actually ended, not just announced.
expect {
    {sash\[} { send_user "PASS: ade exited cleanly, shell returned\n" }
    "SARGA OS PANIC" { send_user "FAIL: kernel panicked after session ended\n"; exit 1 }
    timeout { send_user "FAIL: ade did not exit after session ended\n"; exit 1 }
    eof { send_user "FAIL: QEMU exited after session ended\n"; exit 1 }
}

send_user "\n=== ADE selftest integration: PASS ===\n"
exit 0
