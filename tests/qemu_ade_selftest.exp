}
# 4a11. The full keyboard-loop coverage must have RUN and PASSED: the ring -> arrows -> Enter-close -> re-sync -> arrows cycle across three windows, closed one by one down to the Taskbar fallback. A regression that breaks arrow navigation or the re-sync landing would only surface as a missing verdict without this positive assertion.
expect {
    {\[test\] PASS test_a11y_full_keyboard_loop} {
        send_user "PASS: full a11y keyboard-loop coverage passed\n"
    }
    {\[test\] FAIL test_a11y_full_keyboard_loop} {
