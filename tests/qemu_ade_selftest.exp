        exit 1
    }
    eof {
        send_user "FAIL: QEMU exited before the test_a11y_taskbar_focus_feedback coverage\n"
        exit 1
    }
}
# 4a9. The tooltip-hardening coverage must have RUN and PASSED: the owner-scoped hide / fade-out / keep-alive pins would otherwise only surface as a missing verdict if the test was ever unwired from run_all.
expect {
    {\[test\] PASS test_tooltip_hardening} {
        send_user "PASS: tooltip-hardening coverage passed\n"
    }
    {\[test\] FAIL test_tooltip_hardening} {
