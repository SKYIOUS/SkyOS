        exit 1
    }
}
# 4a10. The role-label coverage must have RUN and PASSED: the unified tooltip_label formatter (Close/Minimize/Switch-to/Start-menu desc) would otherwise only surface as a missing verdict if the test was ever unwired from run_all.
expect {
    {\[test\] PASS test_tooltip_role_labels} {
        send_user "PASS: tooltip role-label coverage passed\n"
    }
    {\[test\] FAIL test_tooltip_role_labels} {
        send_user "FAIL: tooltip role-label test failed\n"
        exit 1
    }
