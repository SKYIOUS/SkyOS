        exit 1
    }
}
# 4a8. The taskbar focus-feedback coverage must have RUN and PASSED: the snapshot's focused_taskbar_btn drives the "light up under the ring" affordance, and a regression that stops lighting the focused button would only surface as a missing verdict without this positive assertion.
expect {
    {\[test\] PASS test_a11y_taskbar_focus_feedback} {
        send_user "PASS: a11y taskbar focus-feedback coverage passed\n"
    }
    {\[test\] FAIL test_a11y_taskbar_focus_feedback} {
